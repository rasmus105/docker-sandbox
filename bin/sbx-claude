#!/usr/bin/env bash
set -euo pipefail

SANDBOX="opencode-$(basename "$PWD")"

if sbx ls 2>/dev/null | awk 'NR>1 {print $1}' | grep -qxF "$SANDBOX"; then
  exec sbx exec -it -w $PWD "$SANDBOX" claude --dangerously-skip-permissions
else
  sbx create -t sandbox-dev --quiet opencode . >/dev/null
  exec sbx exec -it -w $PWD "$SANDBOX" claude --dangerously-skip-permissions
fi
